{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker 名称。自动创建出来的 R2 桶会以此为前缀命名（如 ai-chat-worker-xxx）
  "name": "ai-chat-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  "workers_dev": true,
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // 把 public/index.html 当作纯文本模块 import 进 Worker
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],

  // ⚠️ 关键：这里【故意不写 bucket_name】，Cloudflare 会在部署时自动创建并自动绑定 R2。
  // 如果之后想用已有的桶，把 bucket_name 填上即可（例如 "bucket_name": "my-chat-bucket"）。
  "r2_buckets": [{ "binding": "CHAT_BUCKET" }],

  // ⚠️ 关于环境变量，这里有一条容易踩的坑，务必读完：
  //
  //   wrangler deploy 默认会「先删掉所有明文变量，再写入本文件 vars 里声明的」。
  //   也就是说：只在 Dashboard 里加的【明文】变量，每次重新部署都会被清空。
  //   而【Secret（加密）】类型永远不会被部署删除 —— 部署按钮创建的变量就是 Secret。
  //
  //   所以本项目有两条防线：
  //     1. package.json 的 deploy 脚本用的是 `wrangler deploy --keep-vars`，
  //        它跳过「先删」这一步，Dashboard 上的变量就不会被清掉。
  //     2. 所有变量都建议在 Dashboard 里存成 Secret 类型（部署按钮自动就是这么做的）。
  //
  //   下面这个 vars 块建议保持注释状态：一旦在这里写了同名变量，它会覆盖 Dashboard 上的值，
  //   想改配置就得改代码重新提交，反而更麻烦。只有当你希望配置「跟着代码走、可版本管理」时，
  //   才取消注释并填值。
  "vars": {
    // "MODEL": "gpt-4o-mini",
    // "MODELS": "gpt-4o-mini,gpt-4o",
    // "SYSTEM_PROMPT": "You are a helpful assistant.",
    // "SITE_TITLE": "AI Chat"
  }
}
